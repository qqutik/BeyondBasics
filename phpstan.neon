includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
        - tests
    excludePaths:
        # Pest arch() DSL is built on __call magic that PHPStan cannot type
        - tests/Arch
    tmpDir: storage/framework/phpstan
